NODE_ENV=development
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_SUCCESS_URL=http://localhost:5173/
FRONTEND_ERROR_URL=http://localhost:5173/?notion=error
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Base64 of the Supabase database root CA PEM. Required in production; blank for local development.
DATABASE_SSL_CA_BASE64=
NOTION_CLIENT_ID=YOUR_NOTION_PUBLIC_INTEGRATION_CLIENT_ID
NOTION_CLIENT_SECRET=SET_ONLY_IN_BACKEND_HOST
NOTION_REDIRECT_URI=http://localhost:8787/api/notion/oauth/callback
NOTION_AUTH_URL=https://api.notion.com/v1/oauth/authorize
NOTION_VERSION=2026-03-11
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
TOKEN_ENCRYPTION_KEY_BASE64=SET_ONLY_IN_BACKEND_HOST
OAUTH_STATE_TTL_SECONDS=600
